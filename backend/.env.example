# =============================================================================
# CREDI8 SaaS — copy to backend/.env (never commit real secrets)
# =============================================================================

NODE_ENV=development
APP_ENV=development
PORT=8086
MONGO_URL=mongodb://127.0.0.1:27017/cred8
JWT_SECRET=use-a-long-random-string-at-least-32-chars

# MOCK_MODE=true → Razorpay subscriptions & Twilio calls/WhatsApp are simulated (no keys required).
MOCK_MODE=true
# Secret used to sign mock payment proofs (change in any shared environment).
# MOCK_PAYMENT_SECRET=cred8-mock-payment-secret-change-me
# MOCK_ALLOW_UNSIGNED_WEBHOOKS=1  # only for local webhook replay without Razorpay signing secret

PUBLIC_API_BASE_URL=https://api.yourdomain.com
TRUST_PROXY=0
CORS_ORIGIN=
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30

# =============================================================================
# Razorpay — add when going live (MOCK_MODE=false)
# =============================================================================
RAZORPAY_KEY_ID=YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
RAZORPAY_PLAN_ID_PRO=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_ID_ENTERPRISE=plan_xxxxxxxxxxxx
# RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
# RAZORPAY_CANCEL_IMMEDIATE=0

# =============================================================================
# Twilio — add when going live (MOCK_MODE=false)
# =============================================================================
TWILIO_ACCOUNT_SID=YOUR_SID
TWILIO_AUTH_TOKEN=YOUR_TOKEN
TWILIO_PHONE_NUMBER=YOUR_E164_NUMBER

# Email (password reset)
EMAIL=
EMAIL_PASSWORD=
