# React Native app — copy to `.env.development` and `.env.production` locally (gitignored).
# Values from react-native-config are compiled into the app; use only non-secret public config.
#
# Razorpay keys, JWT_SECRET, Mongo URI, etc. belong in `backend/.env` — never here.

API_BASE_URL=

# ─── AGORA CONFIG ───────────────────────────────
AGORA_APP_ID=                # 🔑 ADD YOUR KEY HERE — from console.agora.io
AGORA_TEMP_TOKEN=            # 🔑 ADD YOUR KEY HERE — generate from Agora Console (for dev only)
AGORA_APP_CERTIFICATE=       # 🔑 ADD YOUR KEY HERE — from Agora Console (for token server)
AGORA_TOKEN_SERVER_URL=      # 🔑 ADD YOUR BACKEND URL HERE — e.g. http://localhost:8080
AGORA_CHANNEL_NAME=main-channel
