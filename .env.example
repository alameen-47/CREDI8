# React Native app — copy to `.env.development` and `.env.production` locally (gitignored).
# Values from react-native-config are compiled into the app; use only non-secret public config.
#
# Twilio, Razorpay keys, JWT_SECRET, Mongo URI, etc. belong in `backend/.env` — never here.

API_BASE_URL=

# Reference only (server / backend/.env — do not put real values in the mobile app):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
